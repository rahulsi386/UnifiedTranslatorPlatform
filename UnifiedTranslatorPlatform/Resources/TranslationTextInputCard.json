{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Enter Text to Translate:",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "Input.Text",
          "placeholder": "enter text",
          "separator": true,
          "isMultiline": true,
          "id": "TextInput"
        }
      ],
      "id": "textInputContainer"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Select Target Language/s:",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Input.ChoiceSet",
                  "choices": [
                    {
                      "title": "Afrikaans",
                      "value": "af"
                    },
                    {
                      "title": "Arabic",
                      "value": "ar"
                    },
                    {
                      "title": "Bangla",
                      "value": "bn"
                    },
                    {
                      "title": "Czech",
                      "value": "cs"
                    },
                    {
                      "title": "Danish",
                      "value": "da"
                    },
                    {
                      "title": "German",
                      "value": "de"
                    },
                    {
                      "title": "English",
                      "value": "en"
                    },
                    {
                      "title": "Spanish",
                      "value": "es"
                    },
                    {
                      "title": "French",
                      "value": "fr"
                    },
                    {
                      "title": "Irish",
                      "value": "ga"
                    },
                    {
                      "title": "Hindi",
                      "value": "hi"
                    },
                    {
                      "title": "Indonesian",
                      "value": "id"
                    },
                    {
                      "title": "Italian",
                      "value": "it"
                    },
                    {
                      "title": "Japanese",
                      "value": "ja"
                    },
                    {
                      "title": "Kannada",
                      "value": "kn"
                    }
                  ],
                  "placeholder": "Placeholder tex",
                  "value": "Spanish",
                  "id": "TargetLang1",
                  "isMultiSelect": true,
                  "wrap": true,
                  "separator": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Input.ChoiceSet",
                  "choices": [
                    {
                      "title": "Korean",
                      "value": "ko"
                    },
                    {
                      "title": "Dutch",
                      "value": "nl"
                    },
                    {
                      "title": "Polish",
                      "value": "pl"
                    },
                    {
                      "title": "Portuguese (Brazil)",
                      "value": "pt"
                    },
                    {
                      "title": "Portuguese (Portugal)",
                      "value": "pt-pt"
                    },
                    {
                      "title": "Romanian",
                      "value": "ro"
                    },
                    {
                      "title": "Russian",
                      "value": "ru"
                    },
                    {
                      "title": "Swedish",
                      "value": "sv"
                    },
                    {
                      "title": "Thai",
                      "value": "th"
                    },
                    {
                      "title": "Turkish",
                      "value": "tr"
                    },
                    {
                      "title": "Ukrainian",
                      "value": "uk"
                    },
                    {
                      "title": "Urdu",
                      "value": "ur"
                    },
                    {
                      "title": "Vietnamese",
                      "value": "vi"
                    },
                    {
                      "title": "Chinese Simplified",
                      "value": "zh-Hans"
                    },
                    {
                      "title": "Chinese Traditional",
                      "value": "zh-Hant"
                    }
                  ],
                  "placeholder": "Placeholder tex",
                  "id": "TargetLang2",
                  "isMultiSelect": true,
                  "style": "expanded"
                }
              ]
            }
          ]
        }
      ],
      "id": "languageContainer"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "Translate",
          "id": "translateButton"
        }
      ]
    }
  ],
  "type": "AdaptiveCard",
  "version": "1.2"
}