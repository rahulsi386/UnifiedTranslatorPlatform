{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Enter Text to Translate:",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "Input.Text",
          "placeholder": "enter text",
          "separator": true,
          "isMultiline": true,
          "id": "TextInput"
        },
        {
          "type": "TextBlock",
          "text": "Select Target Language/s:",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "Input.ChoiceSet",
          "choices": [
            {
              "title": "Spanish",
              "value": "es"
            },
            {
              "title": "French",
              "value": "fr"
            },
            {
              "title": "German",
              "value": "de"
            },
            {
              "title": "Italian",
              "value": "it"
            },
            {
              "title": "Dutch",
              "value": "nl"
            },
            {
              "title": "Polish",
              "value": "pl"
            }
          ],
          "placeholder": "Placeholder text",
          "value": "Spanish",
          "id": "TargetLang",
          "isMultiSelect": true
        }
      ]
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "Translate"
        }
      ]
    }
  ],
  "type": "AdaptiveCard",
  "version": "1.2"
}