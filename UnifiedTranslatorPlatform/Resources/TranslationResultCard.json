{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Language:",
                  "id": "targetLangLbl"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "lang",
                  "id": "targetLang"
                }
              ]
            }
          ]
        }
      ],
      "id": "targetLangContainer"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "translated text",
          "id": "translatedText",
          "color": "Good",
          "size": "Medium",
          "wrap": true,
          "height": "stretch"
        }
      ],
      "id": "translatedTextContainer"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Confidence Score:",
                  "id": "confidenceScoreLbl"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "1.0",
                  "id": "confidenceScore"
                }
              ]
            }
          ],
          "id": "TranslationProps"
        }
      ],
      "id": "translationPropContainer"
    }
  ],
  "type": "AdaptiveCard",
  "version": "1.2"
}